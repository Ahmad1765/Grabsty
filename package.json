{
  "name": "grabsty",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "fonts:web": "node scripts/build-web-fonts.mjs",
    "backfill:thumbnails": "node scripts/backfill-listing-thumbnails.mjs",
    "build": "npm run fonts:web && expo export -p web && node scripts/inject-font-preload.mjs dist",
    "serve:dist": "serve dist -s",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=ceranix --branch=main",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "lint": "expo lint"
  },
  "dependencies": {
